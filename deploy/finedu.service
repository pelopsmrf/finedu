[Unit]
Description=Finedu API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=finedu
WorkingDirectory=/opt/finedu/backend
EnvironmentFile=/etc/finedu/.env
ExecStart=/opt/finedu/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
