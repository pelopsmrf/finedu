[Unit]
Description=Finedu inactivity reminders

[Service]
Type=oneshot
User=finedu
Group=finedu
WorkingDirectory=/srv/finedu/backend
EnvironmentFile=/etc/finedu/finedu.env
ExecStart=/srv/finedu/venv/bin/python -m app.scripts.send_reminders
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/finedu
