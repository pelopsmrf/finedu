[Unit]
Description=Finedu Telegram bot (/start, /delete_my_data)
After=network.target

[Service]
Type=simple
User=finedu
Group=finedu
WorkingDirectory=/srv/finedu/backend
EnvironmentFile=/etc/finedu/finedu.env
ExecStart=/srv/finedu/venv/bin/python -m app.scripts.bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/finedu

[Install]
WantedBy=multi-user.target
